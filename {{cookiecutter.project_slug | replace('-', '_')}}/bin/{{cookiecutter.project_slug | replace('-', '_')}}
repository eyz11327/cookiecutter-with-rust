#!/usr/bin/env python
import os
import sys
import json
from json import JSONDecodeError
import logging

logging.basicConfig(
    level="DEBUG",
    format="{{ cookiecutter.project_slug | upper | replace('-', '_')}} - %(asctime)s - %(name)s - %(module)s - %(levelname)s - %(message)s"
)

import {{ cookiecutter.project_slug | replace('-', '_') }}

cwd = os.getcwd()
logging.info(f"CWD: {cwd}")

secret_config_location = os.getenv("{{ cookiecutter.project_slug | upper | replace('-', '_') }}_SECRET_CONFIG_LOCATION", default = cwd + "/config/secret_config.json")
# Grab the secret config
try:
    with open(secret_config_location, "r") as secret_file:
        try:
            secret_config = json.load(secret_file)
        except JSONDecodeError as err:
            logging.fatal(f"Invalid secret config - ensure valid JSON format. Error: {str(err)}")
            sys.exit(1)
        except Exception as err:
            logging.fatal(f"Invalid secret config - unknown error. Error: {str(err)}")
            sys.exit(1)
except Exception as err:
    logging.fatal(f"Invalid secret config location - please set environment variable {{ cookiecutter.project_slug | upper | replace('-', '_') }}_SECRET_CONFIG_LOCATION to location of the secret config. Error: {str(err)}")
    sys.exit(1)

if __name__ == "__main__":
    {{ cookiecutter.project_slug | replace('-', '_') }}.run(secret_config = secret_config, cwd = cwd)